SECRET_KEY=REPLACE_WITH_RANDOM_SECRET
FIREBASE_PROJECT_ID=YOUR_FIREBASE_PROJECT_ID
FIREBASE_DATABASE_URL=https://YOUR_EXACT_DATABASE_URL.firebasedatabase.app
